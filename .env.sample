# Ev variables to load the default LLM for agents in case if not passed 
ECHO_DEFAULT_LLM_MODEL=anthropic.claude-3-haiku-20240307-v1:0
ECHO_DEFAULT_PROVIDER=bedrock
ECHO_DEFAULT_LLM_TEMPERATURE=0.2
ANTHROPIC_API_KEY='API KEY FOR ANTHROPIC'


# Credentials for using bedrock
AWS_ACCESS_KEY_ID="AWS Access Key Id"
AWS_SECRET_ACCESS_KEY="AWS Secret Access key"
AWS_SESSION_TOKEN="AWS Session Token"
AWS_DEFAULT_REGION=ap-south-1


# Prmopt provider
ECHO_PROMPT_PROVIDER = "langfuse"

# if Lanfuse is the provider for prompt set this
LANGFUSE_SECRET_KEY = "LANGFUSE_SECRET_KEY"
LANGFUSE_PUBLIC_KEY = "LANGFUSE_PUBLIC_KEY"
LANGFUSE_BASE_URL = "https://langfuse.xxx.xxx"


# Audio transcription (batch + streaming)
# ECHO_DEFAULT_TRANSCRIBER_PROVIDER=sarvam
SARVAM_API_KEY="SARVAM_API_KEY"
# SARVAM_STT_MODEL=saarika:v2.5          # batch default
# SARVAM_STT_STREAM_MODEL=saaras:v3      # streaming default
ELEVENLABS_API_KEY="ELEVENLABS_API_KEY"
